# Options of the shawk agent (/etc/shawk/agent.env).
#   -otlp-endpoint          URL of the otlp/shawk receiver of the collector
#   -otlp-protocol          grpc (default) or http/protobuf
#   -otlp-ca-file           CA bundle that verifies the collector
#   -service-name-fallback  exe (default) or unit
SHAWK_AGENT_OPTS="-otlp-endpoint https://collector.example:4327"
