# Options of the shawk agent (/etc/shawk/agent.env).
#   -otlp-endpoint          URL of the otlp/shawk receiver of the collector
#   -otlp-protocol          grpc (default) or http/protobuf
#   -otlp-ca-file           CA bundle that verifies the collector
#   -otlp-cert-file         client certificate the collector requires
#   -otlp-key-file          key of the client certificate
#   -service-name-fallback  exe (default) or unit
SHAWK_AGENT_OPTS="-otlp-endpoint https://collector.example:4327 -otlp-ca-file /etc/shawk/tls/collector-ca.crt -otlp-cert-file /etc/shawk/tls/agent.crt -otlp-key-file /etc/shawk/tls/agent.key"
