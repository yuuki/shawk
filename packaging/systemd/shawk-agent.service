[Unit]
Description=shawk agent: traces the network dependencies of this host
Documentation=https://github.com/yuuki/shawk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set SHAWK_AGENT_OPTS, e.g. -otlp-endpoint https://collector.example:4327
EnvironmentFile=-/etc/shawk/agent.env
ExecStart=/usr/bin/shawk agent $SHAWK_AGENT_OPTS
Restart=on-failure
RestartSec=5s
# Loading BPF programs and reading /proc of other processes needs root;
# the agent keeps no state on disk.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
