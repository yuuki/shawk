[Unit]
Description=shawk agent: traces the network dependencies of this host
Documentation=https://github.com/yuuki/shawk
After=network-online.target
Wants=network-online.target

[Service]
# The agent reports ready (sd_notify READY=1, from its main process as
# NotifyAccess=main by default allows) once its BPF programs are attached
# and the sockets that existed before were adopted, so units ordered after
# this one start traced, and a failure to attach fails the start.
Type=notify
# Set SHAWK_AGENT_OPTS, e.g. -otlp-endpoint https://collector.example:4327
EnvironmentFile=-/etc/shawk/agent.env
ExecStart=/usr/bin/shawk agent $SHAWK_AGENT_OPTS
Restart=on-failure
RestartSec=5s

# The agent runs as root with these capabilities only; it keeps no state
# on disk, opens no port and only dials the collector.
#   CAP_BPF, CAP_PERFMON  load and attach the BPF programs, kprobes included
#   CAP_SYS_ADMIN         enter the other network namespaces (setns) to walk
#                         their sockets; -bpf-stats
#   CAP_SYS_PTRACE        read /proc/PID/exe, environ and ns/net of processes
#                         of other users or with more capabilities
#   CAP_DAC_READ_SEARCH   read /proc/PID/environ of other users (OTEL_SERVICE_NAME)
# Kernels before 5.11 charge BPF memory to RLIMIT_MEMLOCK; with the limit
# raised here the agent needs no CAP_SYS_RESOURCE.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
LimitMEMLOCK=infinity
NoNewPrivileges=yes
# The agent reads the kernel BTF, the cgroup hierarchy, ip_local_port_range,
# the machine id, /proc, the port counters of RDMA devices
# (/sys/class/infiniband, which ProtectKernelTunables leaves readable) and
# the state of the container runtimes (under /var/lib/docker,
# /var/lib/containers, /run/containers and /run/containerd), and resolves
# executables by reading /proc/PID/exe, whose path does not depend on what
# this unit hides. Rootless containers keep their state in the home
# directories hidden by ProtectHome, and are named by id.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
# The agent reads the host name once at start, and the UTS namespace is a
# copy of the host's made at every start.
ProtectHostname=yes
# OTLP over TCP, netlink for the addresses of the interfaces, and a Unix
# socket to report ready to systemd (NOTIFY_SOCKET).
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=net
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# bpf is not in @system-service, nor perf_event_open, which attaches the
# kprobes that learn translations from conntrack. Other calls fail with
# EPERM rather than killing the agent.
SystemCallFilter=@system-service bpf perf_event_open setns
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
