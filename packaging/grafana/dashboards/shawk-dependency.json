        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Dependencies in PostgreSQL",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "shawk-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "shawk-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT client_host, client_service, client_unit, host(client_addr) AS client_addr,\n       server_host, server_service, host(server_addr) AS server_addr, port, proto,\n       observed_by, first_seen, last_seen, client_observed_until, server_observed_until\nFROM shawk_v1.dependencies_between($__timeFrom(), $__timeTo())\n-- A side without a service (a peer without an agent) is named like\n-- in Prometheus: a name of peer_cidrs, ~unresolved or ~external; and\n-- ~other, which folds peers beyond max_peers, matches any of them.\nWHERE (coalesce(client_service, shawk_v1.peer_class(client_addr)) IN (${src:singlequote})\n       OR (client_service IS NULL AND '~other' IN (${src:singlequote})))\n  AND (coalesce(server_service, shawk_v1.peer_class(server_addr)) IN (${dst:singlequote})\n       OR (server_service IS NULL AND '~other' IN (${dst:singlequote})))\nORDER BY last_seen DESC\nLIMIT 500"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Both ends, first and last seen, and how long each side has been observed. A dependency whose last_seen is old while its observer is still observed is no longer used; if both are close, the agent may have stopped."
    },
    {
      "id": 9,
      "type": "table",
      "title": "Dependencies without application-layer instrumentation",
      "datasource": {
        "type": "prometheus",
        "uid": "shawk-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "shawk-prometheus"
          },
          "editorMode": "code",
          "expr": "group by (src, dst) (\n  label_replace(label_replace(\n    shawk:dependency_connections:rate5m{src=~\"$src\", dst=~\"$dst\"} > 0,\n    \"src\", \"$1\", \"src\", \"(?:.*/)?(.*)\"), \"dst\", \"$1\", \"dst\", \"(?:.*/)?(.*)\"))\nunless on (src, dst)\ngroup by (src, dst) (\n  label_replace(label_replace(\n    rate(traces_service_graph_request_total[5m]),\n    \"src\", \"$1\", \"client\", \"(.*)\"), \"dst\", \"$1\", \"server\", \"(.*)\")\n)",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Dependencies shawk sees that are absent from the service graph of OBI (or another tracer), compared without the service namespace, which the service graph does not carry. Peers that OBI cannot name show up here as well."
    }
  ]
}
